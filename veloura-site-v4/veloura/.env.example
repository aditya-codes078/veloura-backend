# Copy this file to .env (or set these as environment variables on your host,
# e.g. Render's "Environment" tab) before running `node server.js`.
# Never commit your real .env file — it's already in .gitignore.

# --- Admin dashboard password (admin.html) ---
# This is the password you type into the "Owner login" screen.
ADMIN_KEY=veloura-aditya-2026

# --- Order alert email ---
# Where new-order emails are sent TO (your inbox).
OWNER_EMAIL=a75127130@gmail.com

# Emails are sent through Resend (https://resend.com) over HTTPS, NOT Gmail
# SMTP — most free hosts (Render, Railway, etc) block outbound SMTP ports,
# which is why Gmail sending fails with "Connection timeout" on them.
#
# Setup (2 minutes, free, no credit card):
#   1. Go to resend.com and sign up using a75127130@gmail.com
#      (sign up with THIS exact address — see note below)
#   2. Dashboard -> API Keys -> Create API Key -> copy it
#   3. Paste it below
#
# Without verifying your own domain, Resend only lets you send TO the email
# address you signed up with -- which is exactly OWNER_EMAIL above, so no
# domain setup is needed.
RESEND_API_KEY=

# --- Optional ---
# PORT=8000
# DB_PATH=/absolute/path/to/data.db
